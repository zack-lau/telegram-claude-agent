# Dependencies
node_modules/

# Environment — copy .env.example and fill in your values
.env

# Runtime data
data/

# Personal projects (prostec is tracked — hosted on Cloudflare)
projects/*
!projects/prostec

# Workspace — personal config (see workspace/.mcp.json.example and workspace/CLAUDE.md.example)
workspace/.mcp.json
workspace/CLAUDE.md
workspace/docs/
workspace/personas/
workspace/*.sh
workspace/*.py
workspace/*.json

# Workspace — MCP servers (environment-specific; contain credentials/config)
workspace/mcp-*/

# Internal planning docs and personal scripts
docs/
scripts/*.sh

# Playwright browser snapshots (may capture PII like phone numbers)
workspace/.playwright-mcp/page-*.yml
workspace/.playwright-mcp/page-*.yaml

# macOS
.DS_Store

# Service account keys and secrets
secrets/
