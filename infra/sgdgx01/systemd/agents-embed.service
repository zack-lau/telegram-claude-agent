[Unit]
Description=agents-embed — BAAI/bge-m3 via vLLM NGC (port 8001)
After=network.target docker.service

[Service]
Type=simple
ExecStartPre=-/usr/bin/docker rm -f agents-embed
ExecStart=/usr/bin/docker run --rm \
  --name agents-embed \
  --gpus all \
  -p 8001:8001 \
  -e HF_HOME=/root/.cache/huggingface \
  -e TRANSFORMERS_CACHE=/root/.cache/huggingface \
  -v /home/agents/.cache/huggingface:/root/.cache/huggingface \
  -v /home/agents/.cache/vllm/embed-bge-m3:/root/.cache/vllm \
  nvcr.io/nvidia/vllm:26.05-py3 \
  vllm serve --model BAAI/bge-m3 \
    --served-model-name bge-m3 \
    --port 8001 \
    --trust-remote-code \
    --gpu-memory-utilization 0.1 \
    --max-model-len 8192
ExecStop=/usr/bin/docker stop agents-embed
Restart=on-failure
RestartSec=30

[Install]
WantedBy=default.target
