# BigQuery patent search (Claude-Patent-Creator)
# Service account JSON with BigQuery read access to patents-public-data
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
GOOGLE_CLOUD_PROJECT=your-project-id

# USPTO API (Claude-Patent-Creator)
# Register free at https://developer.uspto.gov/
USPTO_API_KEY=your-uspto-key

# EPO OPS API (Claude-Patent-Creator, optional — for European patents)
# Register free at https://developers.epo.org/
EPO_CONSUMER_KEY=your-epo-key
EPO_CONSUMER_SECRET=your-epo-secret

# Google OAuth for gogcli (cc-skill-patent-disclosure publish step)
# Run: gog login <your-google-email>  (no env var needed, uses OAuth flow)

# Claude-Patent-Creator MCP server port (default: auto-assigned)
# PATENT_CREATOR_PORT=8888
