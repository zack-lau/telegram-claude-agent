# ── Required ──────────────────────────────────────────────────────────────────

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Comma-separated Telegram user IDs allowed to use the bot
ALLOWED_USERS=123456789

# ── Agent SDK ─────────────────────────────────────────────────────────────────

# Working directory for the agent (default: ./workspace)
# AGENT_CWD=./workspace

# Max tool-use turns per message (default: 15)
# AGENT_MAX_TURNS=15

# Permission mode: bypassPermissions | acceptEdits | default (default: bypassPermissions)
# AGENT_PERMISSION_MODE=bypassPermissions

# ── Optional: Memory (LanceDB MCP) ───────────────────────────────────────────
# Gives the agent persistent long-term memory via a local LanceDB MCP server.
# See workspace/mcp-memory-lancedb/ for setup instructions.

# MEMORY_MCP_COMMAND=./workspace/mcp-memory-lancedb/.venv/bin/python
# MEMORY_MCP_SCRIPT=./workspace/mcp-memory-lancedb/server.py
# SPARK_EMBED_URL=http://your-embed-server:8001
# SPARK_RERANK_URL=http://your-rerank-server:8002

# ── Optional: Doc Search (QMD MCP) ───────────────────────────────────────────
# Enables the agent to search indexed markdown documents.

# SPARK_QMD_MCP_URL=http://your-qmd-server:8181/mcp

# ── Optional: Voice Transcription (Whisper) ──────────────────────────────────
# Transcribes voice messages before passing them to the agent.
# Any OpenAI-compatible /v1/audio/transcriptions endpoint works.

# SPARK_WHISPER_URL=http://your-whisper-server:8007

# ── Optional: TTS, Web Search, Web Crawl ─────────────────────────────────────
# These are read by MCP servers configured in workspace/.mcp.json.

# SPARK_TTS_URL=http://your-tts-server:8008
# SPARK_SEARCH_URL=http://your-searxng-instance:8080
# SPARK_CRAWL_URL=http://your-crawl4ai-instance:11235
