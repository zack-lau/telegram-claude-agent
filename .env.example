# Telegram
TELEGRAM_BOT_TOKEN=your-bot-token-from-botfather
ALLOWED_USERS=your-telegram-user-id

# ── DGX Spark services (your-server / your-server) ──

# Memory — existing MCP Memory LanceDB server (SSE transport)
SPARK_MEMORY_MCP_URL=http://your-server:8282/sse

# QMD Doc Search — existing MCP for hybrid search over markdown/reports
SPARK_QMD_MCP_URL=http://your-server:8181

# Embeddings — BGE-M3 via NVIDIA vLLM
SPARK_EMBED_URL=http://your-server:8001/v1/embeddings
SPARK_EMBED_MODEL=BAAI/bge-m3

# Reranker — BGE Reranker v2 M3
SPARK_RERANK_URL=http://your-server:8002/v1/rerank
SPARK_RERANK_MODEL=BAAI/bge-reranker-v2-m3

# Voice — Whisper transcription + Kokoro TTS
SPARK_WHISPER_URL=http://your-server:8007
SPARK_TTS_URL=http://your-server:8008

# Web search — SearXNG
SPARK_SEARCH_URL=http://your-server:8080

# Web crawl — Crawl4AI
SPARK_CRAWL_URL=http://your-server:11235

# ── Agent SDK ──
AGENT_CWD=./claude-agent/workspace
AGENT_MAX_TURNS=15
AGENT_PERMISSION_MODE=bypassPermissions

# Projects
PROJECTS_ROOT=./projects

# Memory
MEMORY_TOKEN_BUDGET=2000

# Logging
LOG_LEVEL=info
